                <!-- DoHのURLポインタ -->
                <key>ServerURL</key>
                <string>https://dynamic-27-121-223-185.gol.ne.jp</string>
                
                <!-- 問い合わせ先IPアドレスのリスト -->
                <key>ServerAddresses</key>
                <array>
                    <string>27.121.223.185</string>
                </array>
            </dict>
        </dict>
    </array>
